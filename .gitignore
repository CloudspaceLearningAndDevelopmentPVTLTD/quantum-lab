# Playwright artefacts and the manual light-theme screenshots: generated,
# large, and regenerated by `node tests/manual/light-shots.mjs` on demand.
test-results/
playwright-report/
apps/web/tests/manual/shots/

# Claude Code / Cowork session scratch space (workflow worktrees, local
# settings) — never project source, never meant to be committed.
.claude/

# Production secrets for infra/azure/deploy.sh (template: .env.production.example)
# The glob (not just the exact name) is deliberate: infra/azure/.env.production.bak-preadmin
# existed, untracked, for this entire session — a backup carrying the same real
# secrets under a different filename that the exact-match pattern below never
# covered. Caught only by reading `git status` carefully before a push, which is
# exactly the failure mode a glob here is supposed to make impossible.
infra/azure/.env.production
infra/azure/.env.production.*

# Local git bundles used to move work between machines/sessions — large, regenerable.
*.bundle
_to_delete/

# Transient build/deploy logs and fetch state
web-build-log.txt
FETCH_HEAD

# Generated by concatenating the supabase/schema-*.sql files; regenerate rather
# than commit, so it can never drift from the sources.
supabase/combined-setup.sql

# Windows reserved device names, captured accidentally by a `> nul` redirect in
# a script written for a POSIX shell (`> /dev/null`). Such a file cannot even be
# indexed on Windows — `git add` dies with `open("...nul"): No such file or
# directory` — and a checkout of one on Windows fails, so it must never enter
# history. Seen as launch/social/src/nul, 276 kB of captured render output.
nul
[Nn][Uu][Ll].*
con
prn
aux
supabase/.temp/

# MkDocs build output (website/ is the source; see mkdocs.yml)
/site/
