<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background layer: the violet→teal brand gradient used
     nowhere else as directly as this, since the web app's canvases sample
     the tokens as flat colours. 108x108dp canvas per the adaptive-icon spec. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#0D1120"
                android:centerColor="#3A2E7A"
                android:endColor="#0F6E64"
                android:centerX="0.5" />
        </aapt:attr>
    </path>
</vector>
