<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a Bloch sphere glyph — the same "every qubit
     state is one point on a sphere" picture apps/web/app/visualizations/
     bloch-sphere teaches with. Content sits inside the 66dp safe zone of the
     108dp canvas so no launcher mask (circle, squircle, rounded square) clips
     it. Kept to strokes + two dots so it stays legible down to a 32px
     status-bar rendering. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Polar axis -->
    <path
        android:pathData="M54,24 L54,84"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55" />

    <!-- Equator, tilted to suggest a 3D sphere rather than a flat circle -->
    <path
        android:pathData="M28,50.5 C28,44.7 39.6,40 54,40 C68.4,40 80,44.7 80,50.5 C80,56.3 68.4,61 54,61 C39.6,61 28,56.3 28,50.5 Z"
        android:strokeColor="#4EDBCA"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Outer sphere boundary -->
    <path
        android:pathData="M54,24 C68.4,24 80,35.2 80,54 C80,72.8 68.4,84 54,84 C39.6,84 28,72.8 28,54 C28,35.2 39.6,24 54,24 Z"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000" />

    <!-- The state point |ψ⟩ -->
    <path
        android:pathData="M70,38 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#A99DFF" />
    <path
        android:pathData="M70,38 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />
</vector>
