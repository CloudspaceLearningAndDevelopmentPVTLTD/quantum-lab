        android:pathData="M100,40 C128.4,40 152,62.4 152,100 C152,137.6 128.4,160 100,160 C71.6,160 48,137.6 48,100 C48,62.4 71.6,40 100,40 Z"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="3"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000" />

    <path
        android:pathData="M130,68 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0"
        android:fillColor="#A99DFF" />
    <path
        android:pathData="M130,68 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="2"
