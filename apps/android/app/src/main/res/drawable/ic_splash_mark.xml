        android:pathData="M100,40 L100,160"
        android:strokeColor="#EEF2FF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55" />

    <path
        android:pathData="M48,90 C48,79.4 71.6,71 100,71 C128.4,71 152,79.4 152,90 C152,100.6 128.4,109 100,109 C71.6,109 48,100.6 48,90 Z"
        android:strokeColor="#4EDBCA"
        android:strokeWidth="4.5"
        android:fillColor="#00000000" />

