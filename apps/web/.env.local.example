# Quantum Lab web app — local environment template
#
# Copy to .env.local:   cp .env.local.example .env.local
#
# THE APP WORKS FULLY WITHOUT EITHER OF THESE.
# The five visualizations and the circuit simulator are pure client-side
# TypeScript and need nothing at all. The tutor falls back to a built-in
# offline FAQ when no Anthropic key is present.

# Optional. Base URL of services/api, used only if you opt into
# server-side circuit execution (real hardware, vendor backends).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Set this to get live Claude answers in /tutor instead of the
# offline FAQ. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=
