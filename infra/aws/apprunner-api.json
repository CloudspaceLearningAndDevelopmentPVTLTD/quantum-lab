{
  "ServiceName": "quantum-lab-api",
  "SourceConfiguration": {
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/quantum-lab-apprunner-ecr-access"
    },
    "AutoDeploymentsEnabled": false,
    "ImageRepository": {
      "ImageIdentifier": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/quantum-lab/api:<TAG>",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "ALLOWED_ORIGINS": "<WEB_ORIGIN_OR_http://localhost:3000_UNTIL_KNOWN>"
        },
        "RuntimeEnvironmentSecrets": {
          "API_SHARED_SECRET": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/quantum-lab/api-shared-secret"
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "0.5 vCPU",
    "Memory": "1 GB",
    "InstanceRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/quantum-lab-apprunner-instance"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/api/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  },
  "AutoScalingConfigurationArn": "<API_AUTOSCALING_CONFIG_ARN>"
}
