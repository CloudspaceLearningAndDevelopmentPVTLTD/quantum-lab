# infra/azure/.env.production — production secrets for infra/azure/deploy.sh
#
#   cp infra/azure/.env.production.example infra/azure/.env.production
#   (fill in what you have; leave the rest blank)
#   bash infra/azure/deploy.sh
#
# The real file is gitignored. deploy.sh loads it, bakes the NEXT_PUBLIC_*
# values into the web image, and wires everything else onto the right
# container app as a secret (step 7b). Every variable is OPTIONAL: a blank
# one is skipped and the app keeps its documented fallback for that feature.
# Nothing here is ever cleared by the script — removing a secret is done by
# hand with `az containerapp secret remove`.
#
# What each block switches on, and where the value comes from.

# ── Public URL ──────────────────────────────────────────────────────────────
# Baked into every canonical URL, the sitemap, OG tags and the RSS feed.
# Leave blank to auto-detect (first custom domain bound to quantum-lab-web,
# else the *.azurecontainerapps.io FQDN).
PUBLIC_URL=https://qubit16.ai

# ── Platform console (/admin/platform) ──────────────────────────────────────
# Comma-separated emails allowed to open the operator console, where the AI
# tutor's keys, routing and per-tier access are configured LIVE — the block
# below then becomes optional. Sign in with a listed address, open /account.
PLATFORM_ADMIN_EMAILS=
# Encrypts API keys saved in the console (64 hex chars: openssl rand -hex 32).
# Leave blank: deploy.sh generates one and appends it here. Changing it makes
# every key saved in the console unreadable until re-entered.
SETTINGS_ENCRYPTION_KEY=

# ── AI tutor env layer (optional once the console is set up) ────────────────
# Cheapest first — docs/LLM-GATEWAY.md. Keys saved in the console override
# these. Without either, the tutor answers from built-in offline material.
GEMINI_KEY=                       # https://aistudio.google.com/apikey (free tier)
GROQ_KEY=                         # https://console.groq.com/keys
ANTHROPIC_KEY=                    # https://console.anthropic.com
# Pin to one provider regardless of the order above: gemini|groq|anthropic|azure
FORCE_LLM_PROVIDER=
# Azure OpenAI as a fourth provider (docs/AZURE-CREDITS.md) — all three or none.
AZURE_API_KEY=
AZURE_API_BASE=                   # https://<resource>.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# ── Accounts, cross-device sync, exams, orgs (Supabase — supabase/README.md) ─
# Without these: no sign-in; circuits and progress stay in the browser. Run
# the schema files in supabase/ in the documented order first.
NEXT_PUBLIC_SUPABASE_URL=         # Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=        # Project Settings → API → service_role (server only)

# ── Launch promotion: everything free ───────────────────────────────────────
# A signed-in account is treated as Pro (real hardware, live tutor, advanced
# track) with no card and nothing to cancel; a real paid plan always wins.
#
# TWO FORMS, and the difference matters:
#
#   NEXT_PUBLIC_LAUNCH_TRIAL_DAYS   per-account, ROLLING. "N days from signup."
#       Needs Supabase AND the service-role key, since it reads the account's
#       age; without the key the trial is granted but cannot expire.
#
#   NEXT_PUBLIC_LAUNCH_TRIAL_UNTIL  absolute. "Free for everybody until this
#       date", whenever they registered. Needs neither — no account lookup.
#
# USE 'UNTIL' FOR A PROMOTION WITH AN END DATE. The day count is rolling, so on
# its own "everything is free for the next three months" quietly becomes six
# months for somebody who signs up in the last week, and there is no instant at
# which it is over for everybody. Setting both ends the trial at whichever
# comes first, which also caps how long any one account sits on Pro.
#
# WHAT IS STILL METERED: the quotas. A trial account is Pro, so it gets Pro's
# allowance — 50 hardware jobs a month, not unlimited. QPU time is bought with
# real money; the promotion is about not charging for ACCESS.
#
# Blank turns each form off. lib/billing/launchTrial.ts has the reasoning.
NEXT_PUBLIC_LAUNCH_TRIAL_DAYS=
NEXT_PUBLIC_LAUNCH_TRIAL_UNTIL=2027-01-01

# ── Aggregate analytics (Supabase — supabase/schema-analytics.sql) ──────────
# Without these: analytics stay local-first — every event lives only in each
# visitor's own browser (/insights reads it back there) and nothing is ever
# transmitted, per lib/analytics/track.ts. Setting BOTH turns on a real sink
# so drop-off is visible in aggregate; run supabase/schema-analytics.sql (or
# `supabase db push`) first, or events are accepted and silently discarded.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT is baked into the client bundle at build
# time, same as every other NEXT_PUBLIC_* value — a same-origin URL avoids
# adding anything to the CSP connect-src beyond what 'self' already covers.
# Use the FULL absolute URL (https://your-domain/api/analytics), not a bare
# "/api/analytics" — deploy.sh builds via Git Bash/MSYS on Windows, which
# rewrites a --build-arg value starting with "/" into a Windows path before
# it reaches `docker build`, breaking the build outright. An absolute URL
# behaves identically at runtime and sidesteps that entirely.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://your-domain.example/api/analytics
ANALYTICS_SUPABASE_TABLE=analytics_events

# ── Billing (Stripe — docs/STRIPE-SETUP.md, docs/BILLING.md) ────────────────
# Requires Supabase + supabase/schema-billing.sql. Without these /pricing
# shows plans but cannot check out. Leave blank while the launch trial is on.
STRIPE_SECRET_KEY=                # Developers → API keys → Secret key
STRIPE_WEBHOOK_SECRET=            # Developers → Webhooks → endpoint signing secret
BILLING_RECONCILE_SECRET=         # any long random string; protects the reconcile route
                                  #   openssl rand -hex 32

# ── Transactional email (Resend — docs/ONBOARDING.md) ───────────────────────
# Onboarding sequence + course schedule. Without these nothing is sent.
RESEND_API_KEY=                   # https://resend.com/api-keys
EMAIL_FROM=                       # e.g. "Qubit16 <hello@qubit16.ai>" — domain verified in Resend
EMAIL_DISPATCH_SECRET=            # any long random string; protects the dispatch route
                                  #   openssl rand -hex 32

# ── Error tracking (Sentry — docs/OPERATIONS.md) ────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=           # Project → Client Keys (DSN); public by design
SENTRY_AUTH_TOKEN=                # source-map upload only; optional even with a DSN
SENTRY_ORG=
SENTRY_PROJECT=

# ── Rate limiting across replicas (Upstash Redis REST) ──────────────────────
# Without these limits are per-instance (fine at max-replicas 1).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Operations ──────────────────────────────────────────────────────────────
# Gates /api/health?deep=1 (docs/SECURITY.md HEALTH-1). Strongly recommended.
HEALTH_DEEP_TOKEN=                #   openssl rand -hex 32

# ── Real quantum hardware (services/api — docs/HARDWARE.md) ─────────────────
# Without these /hardware lists no real devices and says which token is missing.
IBM_QUANTUM_TOKEN=                # https://quantum.ibm.com → API token
AWS_ACCESS_KEY_ID=                # IAM user with AmazonBraketFullAccess
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Managed data services (docs/AZURE-CREDITS.md) ───────────────────────────
# Provisioned and wired by deploy.sh itself when this is true; leave false
# unless you are spending Founders Hub credits on Postgres/Redis/Azure OpenAI.
ENABLE_MILESTONE_WORKLOADS=false
