{
  "name": "quantum-lab",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive quantum mechanics learning platform: visualizations, a circuit simulator, and an AI tutor.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "api": "cd services/api && uvicorn app.main:app --reload --port 8000"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
